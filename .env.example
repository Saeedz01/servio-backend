# Application
PORT=3001
NODE_ENV=development

# PostgreSQL — fill in your credentials
# Neon: use the pooled host (-pooler) and keep the API process running so
# Prisma keep-alive prevents compute sleep. Local Postgres is much faster for day-to-day dev.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connect_timeout=10"

# Or set individual fields (optional; Prisma uses DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=servio

# JWT — change in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:3000,https://serveo-frontend.vercel.app
