generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING
  VERIFIED
  REJECTED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum PriceUnit {
  PROJECT
  HOUR
  FLAT
}

enum BookingStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum JobStatus {
  OPEN
  AWARDED
  CLOSED
}

enum BiddingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TokenLedgerType {
  GRANT_MONTHLY
  SPEND_UNLOCK
}

enum ContactUnlockTargetType {
  BOOKING
  JOB
}

model Role {
  id        String     @id @default(uuid())
  roleName  String     @unique @map("role_name")
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id        String        @id @default(uuid())
  name      String
  phone     String        @unique
  password  String
  roleId    String        @map("role_id")
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  role                   Role            @relation(fields: [roleId], references: [id])
  provider               Provider?
  bookings               Booking[]
  jobs                   Job[]
  messageThreadsAsSeeker MessageThread[] @relation("SeekerMessageThreads")
  messageThreadsAsAdmin  MessageThread[] @relation("AdminMessageThreads")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Provider {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  idCardFront String   @map("id_card_front")
  idCardBack  String   @map("id_card_back")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services       Service[]
  bookings       Booking[]
  biddings       Bidding[]
  notifications  Notification[]
  messageThreads MessageThread[]
  tokenWallet    ProviderTokenWallet?
  tokenLedger    ProviderTokenLedger[]
  contactUnlocks ContactUnlock[]

  @@map("providers")
}

model ProviderTokenWallet {
  id         String   @id @default(uuid())
  providerId String   @unique @map("provider_id")
  balance    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_token_wallets")
}

model ProviderTokenLedger {
  id           String          @id @default(uuid())
  providerId   String          @map("provider_id")
  type         TokenLedgerType
  amount       Int
  balanceAfter Int             @map("balance_after")
  /** For GRANT_MONTHLY: YYYY-MM. */
  monthKey     String?         @map("month_key")
  refType      ContactUnlockTargetType? @map("ref_type")
  refId        String?         @map("ref_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([providerId, type, monthKey])
  @@map("provider_token_ledgers")
}

model ContactUnlock {
  id         String                   @id @default(uuid())
  providerId String                   @map("provider_id")
  targetType ContactUnlockTargetType  @map("target_type")
  targetId   String                   @map("target_id")
  createdAt  DateTime                 @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, targetType, targetId])
  @@index([providerId])
  @@index([targetType, targetId])
  @@map("contact_unlocks")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]
  jobs     Job[]

  @@map("service_categories")
}

model Service {
  id           String        @id @default(uuid())
  providerId   String        @map("provider_id")
  categoryId   String        @map("category_id")
  title        String
  description  String
  imageUrl     String        @map("image_url")
  address      String
  lat          Float
  lng          Float
  radiusKm     Float         @map("radius_km")
  priceAmount  Float         @map("price_amount")
  priceUnit    PriceUnit     @map("price_unit")
  availability Json
  status       ServiceStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  provider Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@index([providerId])
  @@index([status])
  @@index([categoryId])
  @@map("services")
}

model Booking {
  id           String        @id @default(uuid())
  serviceId    String        @map("service_id")
  providerId   String        @map("provider_id")
  seekerId     String        @map("seeker_id")
  serviceTitle String        @map("service_title")
  address      String
  lat          Float
  lng          Float
  requestedAt      DateTime      @map("requested_at")
  note             String        @default("")
  status           BookingStatus @default(PENDING)
  /** When the provider first opened this booking (clears Bookings unread). */
  providerViewedAt DateTime?     @map("provider_viewed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider      Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  seeker        User           @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  messageThread MessageThread?

  @@index([providerId])
  @@index([seekerId])
  @@index([status])
  @@index([serviceId])
  @@map("bookings")
}

model Job {
  id          String    @id @default(uuid())
  categoryId  String    @map("category_id")
  seekerId    String    @map("seeker_id")
  title       String
  description String
  address     String
  lat         Float
  lng         Float
  /** When the seeker needs the work done. */
  requestedAt DateTime  @map("requested_at")
  status      JobStatus @default(OPEN)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seeker   User            @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  biddings Bidding[]

  @@index([categoryId])
  @@index([seekerId])
  @@index([status])
  @@map("jobs")
}

model Bidding {
  id         String        @id @default(uuid())
  jobId      String        @map("job_id")
  providerId String        @map("provider_id")
  price      Float
  note       String        @default("")
  status     BiddingStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([jobId, providerId])
  @@index([jobId])
  @@index([providerId])
  @@index([status])
  @@map("bidding")
}

model Notification {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  type       String
  title      String
  body       String
  href       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([read])
  @@map("notifications")
}

enum MessageSenderRole {
  SEEKER
  PROVIDER
  ADMIN
}

/**
 * Conversation between a provider and either a seeker (booking/service)
 * or an admin (service moderation). Exactly one of seekerId / adminId is set.
 */
model MessageThread {
  id                 String    @id @default(uuid())
  bookingId          String?   @unique @map("booking_id")
  providerId         String    @map("provider_id")
  seekerId           String?   @map("seeker_id")
  adminId            String?   @map("admin_id")
  serviceId          String?   @map("service_id")
  serviceTitle       String    @default("") @map("service_title")
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String    @default("") @map("last_message_preview")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  provider   Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  seeker     User?              @relation("SeekerMessageThreads", fields: [seekerId], references: [id], onDelete: Cascade)
  admin      User?              @relation("AdminMessageThreads", fields: [adminId], references: [id], onDelete: Cascade)
  messages   Message[]
  readStates MessageReadState[]

  @@index([providerId])
  @@index([seekerId])
  @@index([adminId])
  @@index([serviceId])
  @@index([lastMessageAt])
  @@map("message_threads")
}

model Message {
  id         String            @id @default(uuid())
  threadId   String            @map("thread_id")
  senderRole MessageSenderRole @map("sender_role")
  /** Seeker user id or provider profile id, matching senderRole. */
  senderId   String            @map("sender_id")
  body       String            @default("")
  /** [{ id, name, mimeType, sizeBytes, url }] — data URLs or http(s). */
  attachments Json             @default("[]")
  editedAt    DateTime?        @map("edited_at")
  deletedAt   DateTime?        @map("deleted_at")
  /** Peer client acknowledged receipt (1:1). */
  deliveredAt DateTime?        @map("delivered_at")
  /** Peer marked the thread read covering this message (1:1). */
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([threadId, createdAt])
  @@index([createdAt])
  @@map("messages")
}

model MessageReadState {
  id              String            @id @default(uuid())
  threadId        String            @map("thread_id")
  participantRole MessageSenderRole @map("participant_role")
  participantId   String            @map("participant_id")
  lastReadAt      DateTime          @map("last_read_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, participantRole, participantId])
  @@index([threadId])
  @@map("message_read_states")
}
